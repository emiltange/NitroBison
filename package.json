{
  "name": "nitrobison-markdown",
  "version": "1.6.5",
  "description": "Offline-first Markdown workspace with connected notes, graphs and optional cloud sync.",
  "author": "NitroBison contributors",
  "main": "desktop/main.js",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-sw.js && node scripts/build-notices.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:build": "npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:mac": "npm run build && electron-builder --mac dmg --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew assembleDebug",
    "check": "node --check src/app.js && node --check src/workspace.js && node --check src/cloud.js && node --check server/index.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "dompurify": "^3.3.0",
    "marked": "^17.0.0",
    "mermaid": "^12.3.0"
  },
  "overrides": {
    "@electron/universal": "^3.0.6",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "org.nitrobison.app",
    "productName": "NitroBison",
    "directories": {
      "output": "release",
      "buildResources": "desktop/icons"
    },
    "files": [
      "desktop/*.js",
      "desktop/*.cjs",
      "dist/**/*",
      "src/core.js",
      "src/markdown-model.js",
      "src/markdown-paths.js",
      "src/directory.js",
      "src/ai.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "desktop/icons/icon.ico",
      "artifactName": "NitroBison-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "desktop/icons/installer-outcome.bmp",
      "include": "desktop/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "desktop/icons/icon.icns"
    }
  }
}
